	<trans>Нет доступа</trans>
    </entry>
    <entry>
	<base>PASSWORD_LOGIN_PRIVATE</base>
	<trans>Принимать пароли только из локальных сетей</trans>
    </entry>
    <entry>
	<base>PASSWORD_LOGIN_PUBLIC</base>
	<trans>Принимать пароли отовсюду</trans>
    </entry>

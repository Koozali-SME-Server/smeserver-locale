#: root/usr/share/perl5/vendor_perl/esmith/console/configure.pm:937
msgid "ISDN"
msgstr "ISDN"

#: root/usr/share/perl5/vendor_perl/esmith/console/configure.pm:904
msgid "internal ISDN card"

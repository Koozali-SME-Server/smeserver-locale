#: root/usr/share/perl5/vendor_perl/esmith/console/backup_running.pm:29
msgid "Inconsistent system state"
msgstr "Inkonsistent systemstatus"

#: root/usr/share/perl5/vendor_perl/esmith/console/backup_running.pm:31

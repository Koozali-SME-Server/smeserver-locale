#: root/sbin/e-smith/console-menu-items/reboot.pl:52
#: root/usr/share/perl5/vendor_perl/esmith/console/perform_backup.pm:232
#: root/usr/share/perl5/vendor_perl/esmith/console/perform_restore.pm:270
